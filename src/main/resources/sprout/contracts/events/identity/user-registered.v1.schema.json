{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sainayakk.github.io/sprout-platform/contracts/events/identity/user-registered.v1.schema.json",
  "title": "identity.user.registered v1",
  "description": "Published by identity once a new account is stored. Consumers (accounts, rewards) use it to start onboarding. Delivered at least once: consumers must ignore an eventId they have already processed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "producer", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "Unique per event. The idempotency key for consumers." },
    "eventType": { "const": "identity.user.registered" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "sprout-identity" },
    "correlationId": { "type": "string", "description": "The request id that caused this event, for tracing." },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "email", "displayName"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    }
  }
}
